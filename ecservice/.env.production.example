APP_NAME=Athar
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.motabaah.com
# Optional safety net if config:cache ever bakes in localhost — should match APP_URL on LIVE.
API_URL=https://api.motabaah.com
FRONT_URL=https://platform.motabaah.com

# Media storage (Bunny Storage + Pull Zone CDN token URLs for playback/download).
UPLAOD_FILE_STORAGE=bunnycdn
UPLAOD_REGION=
BUNNYCDN_BASE_HOSTNAME=storage.bunnycdn.com
BUNNYCDN_STORAGE_ZONE=
BUNNYCDN_API_KEY=
BUNNYCDN_ACCESS_KEY=
BUNNYCDN_TOKEN_KEY=
BUNNYCDN_URL=
BUNNYCDN_PULL_ZONE_ID=
LARAVEL_FILE_SYSTEM_KEY=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Do not switch these unless LIVE has Redis (phpredis or predis) AND redis-cli ping succeeds:
# CACHE_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_CLIENT=phpredis

# Do not switch the queue off sync unless a worker is running and the jobs table exists:
# QUEUE_CONNECTION=database

# After deploy on LIVE:
# php artisan motabaa:optimize
